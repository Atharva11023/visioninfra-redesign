# ─────────────────────────────────────────────────────────────
# VIESL Website — Environment Variables
# ─────────────────────────────────────────────────────────────
# Copy this file:  cp .env.example .env.local
# NEVER commit .env.local to version control.
# ─────────────────────────────────────────────────────────────

# Contact form email backend (https://resend.com — free tier available)
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google Analytics 4 (optional — https://analytics.google.com)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Deployment environment (set automatically by Vercel)
# NODE_ENV=production
